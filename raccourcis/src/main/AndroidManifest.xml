<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Aucune permission : l'application ne fait qu'ouvrir d'autres applications. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- Visibilité des applications cibles (Android 11 et plus). -->
    <queries>
        <package android:name="com.mediatek.camera" />
        <package android:name="com.google.android.apps.calculator" />
        <package android:name="com.sunmi.gallery" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_camera"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.NoDisplay">

        <activity
            android:name=".CameraShortcut"
            android:exported="true"
            android:icon="@drawable/ic_camera"
            android:label="@string/camera"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CalculatorShortcut"
            android:exported="true"
            android:icon="@drawable/ic_calculator"
            android:label="@string/calculator"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GalleryShortcut"
            android:exported="true"
            android:icon="@drawable/ic_gallery"
            android:label="@string/gallery"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
